#!/bin/sh

files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$')

if [ -z "$files" ]; then
  exit 0
fi

if [ -x node_modules/.bin/eslint ]; then
  ESLINT=node_modules/.bin/eslint
else
  ESLINT=eslint
fi

echo "pre-commit: перевірка ESLint..."
$ESLINT $files
if [ $? -ne 0 ]; then
  echo "pre-commit: знайдено помилки стилю, коміт скасовано"
  exit 1
fi

echo "pre-commit: помилок не знайдено"
exit 0
